{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigests"],
  "ignorePresets": ["security:minimumReleaseAgeNpm"],
  "dependencyDashboard": {
    "enabled": false
  },
  "minimumReleaseAge": "14 days",
  "statusCheckNames": {
    "minimumReleaseAge": null
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "schedule": ["* * * * 6"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 6"],
    "automerge": true,
    "labels": ["dependencies", "automerge"]
  },
  "labels": ["dependencies"],
  "assignees": ["iimuz"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Look up mise conda tools on conda-forge: the mise manager passes a bare package name without a channel, and the default anaconda.org registry needs <channel>/<name>, so lookups fail. mise itself installs conda tools from conda-forge by default",
      "matchManagers": ["mise"],
      "matchDatasources": ["conda"],
      "registryUrls": ["https://api.anaconda.org/package/conda-forge/"]
    },
    {
      "description": "Disable Python version updates in requires-python: uv.lock cannot be regenerated until dependencies support the new Python, so humans bump requires-python, uv.lock and ruff target-version together",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Skip minimum release age for pin and digest updates",
      "matchUpdateTypes": ["pin", "digest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group all other major updates",
      "matchUpdateTypes": ["major"],
      "groupName": "other (major)"
    },
    {
      "description": "Group all other minor updates",
      "matchUpdateTypes": ["minor"],
      "groupName": "other (minor)"
    },
    {
      "description": "Group all other patch updates",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "other (patch)"
    },
    {
      "description": "Group GitHub Actions major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions (major)"
    },
    {
      "description": "Group GitHub Actions minor updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor"],
      "groupName": "github-actions (minor)"
    },
    {
      "description": "Group GitHub Actions patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "github-actions (patch)"
    },
    {
      "description": "Group npm/Node.js major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm (major)"
    },
    {
      "description": "Group npm/Node.js minor updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm (minor)"
    },
    {
      "description": "Group npm/Node.js patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "npm (patch)"
    },
    {
      "description": "Group mise major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "groupName": "mise (major)"
    },
    {
      "description": "Group mise minor updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor"],
      "groupName": "mise (minor)"
    },
    {
      "description": "Group mise patch updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "mise (patch)"
    },
    {
      "description": "Automerge every update except major through GitHub auto-merge, which waits for the required status-check, and mark those pull requests with the automerge label. The global labels omit automerge so that the label appears only on pull requests that merge automatically. Placed last so that it applies on top of the group rules",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "labels": ["dependencies", "automerge"]
    }
  ]
}
